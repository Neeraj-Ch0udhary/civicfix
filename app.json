{
  "expo": {
    "name": "SmartShehar",
    "slug": "smartshehar",
    "version": "1.0.0",
    "scheme": "smartshehar",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1931"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1931"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "experiments": {
      "tsconfigPaths": true
    }
  }
}